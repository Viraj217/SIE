# ── Client-visible (inlined into the browser bundle at build time) ──────────
# Only put values here that are safe to publish.

# Google Tag Manager container, e.g. GTM-XXXXXXX (preferred).
NEXT_PUBLIC_GTM_ID=""
# …or GA4 measurement ID directly, e.g. G-XXXXXXXXXX. Set one, not both.
NEXT_PUBLIC_GA_ID=""

# ── Server-only ────────────────────────────────────────────────────────────
# Where the Express/Prisma inquiry API lives. Read only inside /api/rfq, so it
# can differ per environment without rebuilding the client bundle.
# In production this MUST be the deployed backend, not localhost.
BACKEND_API_URL="https://shah-industrial-backend.onrender.com"

# ── Client-visible (inlined into the browser bundle at build time) ──────────
# Used by frontend client components (Timeline, Products, Industries, and Admin pages)
NEXT_PUBLIC_API_URL="https://shah-industrial-backend.onrender.com"

# Shared only by the Next.js server and Express API. Use the same long random
# value in both deployments. Required in production; never prefix with NEXT_PUBLIC.
RFQ_RELAY_SECRET=""
