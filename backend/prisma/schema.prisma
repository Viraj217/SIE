datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Admin users (the Shah family) who manage inventory and quote inquiries
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(OWNER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum Role {
  ADMIN
  OWNER
}

/// Evolved customer inquiry/quote submission (handles both legacy and structured RFQ)
model Inquiry {
  id                   String         @id @default(uuid())
  rfqNumber            String?        @unique     // null for legacy rows

  // ── Legacy fields (kept for backward compatibility with existing views) ──
  name                 String                     // legacy: buyer name / compatibility
  company              String                     // legacy: company name / compatibility
  contactInfo          String                     // legacy: combined contact string / compatibility
  requirements         String?                    // legacy: text blob; optional for structured RFQ

  // ── New structured fields (nullable — legacy rows don't have them) ──
  contactPerson        String?
  email                String?
  phone                String?
  city                 String?
  gstNumber            String?
  deliveryLocation     String?
  requiredDeliveryDate DateTime?      @db.Date    // Date-only, no timezone shifting
  message              String?

  // ── Pipeline fields ──
  source               InquirySource  @default(LEGACY)
  status               InquiryStatus  @default(PENDING)
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // ── Relations ──
  items                InquiryItem[]
}

/// Structured line items for RFQ
model InquiryItem {
  id            String   @id @default(uuid())
  inquiryId     String
  inquiry       Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  materialGrade String
  productType   String
  od            Decimal? @db.Decimal(12, 2)   // millimetres
  idDimension   Decimal? @db.Decimal(12, 2)   // millimetres
  length        Decimal? @db.Decimal(12, 2)   // millimetres
  quantity      Decimal  @db.Decimal(12, 4)   // supports fractional metric units (e.g. 2.5 MT)
  quantityUnit  String                        // NOS, KG, METER, MT
  process       String?
  remarks       String?
  createdAt     DateTime @default(now())
}

/// Concurrency-safe atomic RFQ counter
model RfqCounter {
  year       Int @id           // Business year in Asia/Kolkata
  lastNumber Int @default(0)   // atomically incremented
}

enum InquirySource {
  WEBSITE
  EMAIL
  WHATSAPP
  MANUAL
  LEGACY
}

enum InquiryStatus {
  // === Legacy values (kept for existing rows) ===
  PENDING
  REVIEWED
  CONTACTED
  ARCHIVED

  // === Shared value ===
  QUOTED

  // === New CRM pipeline values ===
  NEW
  REVIEWING
  CLARIFICATION_REQUIRED
  QUOTE_PREPARING
  NEGOTIATION
  WON
  LOST
  DORMANT
}

/// Steel/iron product types in the catalog
model Product {
  id           String        @id @default(uuid())
  slug         String        @unique
  title        String
  tagline      String
  category     Category      @default(RAW_MATERIAL)
  isFeatured   Boolean       @default(false)
  isActive     Boolean       @default(true)
  displayOrder Int           @default(0)
  specs        ProductSpec[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum Category {
  RAW_MATERIAL
  ALLOY
  SERVICE
}

/// Technical specifications for products (one-to-many)
model ProductSpec {
  id           String  @id @default(uuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label        String
  value        String
  displayOrder Int     @default(0)
}

/// Company historical timeline milestones
model TimelineMilestone {
  id           String   @id @default(uuid())
  year         String
  title        String
  description  String
  imagePath    String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

/// Industry sectors served
model IndustrySector {
  id           String @id @default(uuid())
  name         String
  slug         String @unique
  description  String
  iconName     String
  displayOrder Int    @default(0)
}
