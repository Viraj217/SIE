# PostgreSQL connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shah_industrial?schema=public"

# Server config
PORT=5000

# Admin session secret
ADMIN_JWT_SECRET="temporary_local_secret_key_for_testing"
ADMIN_SEED_EMAIL="admin@shahindustrial.com"
ADMIN_SEED_PASSWORD=""

# Must match the server-only value configured on the frontend deployment.
RFQ_RELAY_SECRET=""

# Public frontend origin used by the admin/browser API CORS allow-list.
FRONTEND_URL="http://localhost:3000"

# (Optional) Email notifications for new inquiries
RESEND_API_KEY=""
ADMIN_NOTIFICATION_EMAIL="sales@shahindustrial.com"
